<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<CodeBlocks_project_file>
<FileVersion major="1" minor="6" />
<Project>
<Option title="AD24N_aec_decode" />
<Option compiler="pi32_large_lto_compiler" />
<Build>
<Target title="Release">
<Option output="app/post_build/sh58/sdk.elf" prefix_auto="0" extension_auto="0" />
<Option object_output="obj/Release/" />
<Option type="1" />
<Option compiler="pi32_large_lto_compiler" />
<Compiler>
<Add option="-DCONFIG_CPU_SH58=1" />
<Add option="-DD_TOY_SDK=1" />
<Add option="-DD_APP_TOY=1" />
<Add option="-DSR_DEFAULT=16000" />
<Add option="-DMAX_POOL=48" />
<Add option="-integrated-as" />
<Add option="-g" />
<Add option="-Oz" />
<Add option="-flto" />
<Add option="-fprefer-gnu-section" />
<Add option="-fms-extensions" />
<Add option="-Wno-empty-body" />
<Add option="-Wcast-align" />
<Add option="-Wundef" />
<Add option="-mllvm -pi32-large-program=true" />
<Add option="-DFPGA=0" />
<Add option="-DCPU_SH58=1" />
<Add option="-DAUDIO_ADC_EN=1" />
<Add option="-DAUX_EN" />
<Add option="-DENCODER_EN" />
<Add option="-DHAS_F1A_DECODER" />
<Add option="-DHAS_MAX_F1A_NUMBER=1" />
<Add option="-DHAS_MIDI_KEYBOARD_DECODER" />
<Add option="-DHAS_A_DECODER" />
<Add option="-DHAS_EXT_FLASH_EN" />
<Add option="-DHAS_USB_EN=0" />
<Add option="-DHAS_MIO_PLAYER" />
<Add option="-DHAS_HW_SRC_MODULE=1" />
<Add option="-DHAS_UPDATE_EN=0" />
<Add option="-DHAS_NORFS_EN" />
<Add option="-DHAS_FREEFS_EN" />
<Add option="-DSIMPLE_FATFS_ENABLE=0" />
<Add option="-DSYS_VM_EN=0" />
<Add option="-DHAS_A_ENCODER" />
<Add option="-DHAS_SIMPLE_DEC_MODE" />
<Add option="-DHAS_AEC_MODE" />
<Add option="-DNOFLOAT" />

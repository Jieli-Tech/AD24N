<Add option="-Tapp/post_build/sh58/app.ld" />
<Add option="-M=app/post_build/sh58/app.map" />
</Linker>
<ExtraCommands>
<Add before="$compiler $options $includes -D__LD__ -E -P app\post_build\sh58\aec_decode\app_ld.c -o app\post_build\sh58\app.ld" />
<Add before="$compiler $options $includes -D__LD__ -E -P app\post_build\sh58\aec_decode\download_bat.c -o app\post_build\sh58\download.bat" />
<Add before="tools\utils\fixbat.exe app\post_build\sh58\download.bat" />
<Add before="$compiler $options $includes -D__LD__ -E -P app\post_build\sh58\aec_decode\isd_config_ini.c -o app\post_build\sh58\aec_decode\isd_config.ini" />
<Mode before="always" />
<Add after="app\post_build\sh58\download.bat sdk" />
<Mode after="always" />
</ExtraCommands>
</Target>
</Build>
